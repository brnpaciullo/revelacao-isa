{
  "name": "cha-revelacao-palmeiras",
  "version": "1.0.0",
  "description": "Cha revelacao estilo casa de apostas com tema Palmeiras e votacao ao vivo",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon --ignore server/data.json --watch server --watch api --watch lib server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "express": "^4.19.2",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
